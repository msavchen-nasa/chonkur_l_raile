<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="scene_camera" params="
        tf_prefix:=''
        parent:=world
        name:=''
        mount_width_meters:=0.14
        mount_height_meters:=0.2
        mount_depth_meters:=0.01135
        *origin
        use_camera_mesh:=true
    ">

    <joint name="${tf_prefix}${name}_mount_base_joint" type="fixed">
        <parent link="${parent}"/>
        <child link="${tf_prefix}${name}_mount"/>
        <xacro:insert_block name="origin"/>
    </joint>

    <link name="${tf_prefix}${name}_mount">
        <visual>
            <!-- <origin rpy="0 0 0" xyz="${mount_width_meters/2} ${-1*mount_depth_meters/2} ${-1*mount_height_meters/2}"/> -->
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <!-- <box size="${mount_width_meters} ${mount_depth_meters} ${mount_height_meters}"/> meters -->
                <box size="0.01 0.01 0.01"/> <!--meters -->
            </geometry>
            <material name="${tf_prefix}${name}_mount">
                <color rgba="0.8 0.8 0.8 1"/>
            </material>
        </visual>
        <collision>
            <!-- <origin rpy="0 0 0" xyz="${mount_width_meters/2} ${-1*mount_depth_meters/2} ${-1*mount_height_meters/2}"/> -->
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <!-- <box size="${mount_width_meters} ${mount_depth_meters} ${mount_height_meters}"/> meters -->
                <box size="0.01 0.01 0.01"/> <!--meters -->
            </geometry>
        </collision>
    </link>

    <!-- Realsense camera -->
    <xacro:property name="realsense_materials_defined" value="true" />
    <!-- ^^ Avoid Error   material 'aluminum' is not unique.
        This doesn't work in old versions (v4.51) of the realsense2_description because there are no header guards at all
        Version 4.54.1 has header guards but they don't work as expected.
    -->

    <!-- Pose obtained from Measuring by hand. Origin is lift_camera_bottom_screw_frame-->
    <!-- <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro" />
    <xacro:sensor_d435 parent="${tf_prefix}lift_camera_mount" use_nominal_extrinsics="true" use_mesh="${use_camera_mesh}" name="hand_measured_lift_camera">
        <origin xyz="0.076 0.01 -0.1725" rpy="3.1415 0 1.5708"/>
    </xacro:sensor_d435> -->

    <!-- Pose after camera calibration -->
    <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro" />
    <xacro:sensor_d435 parent="${tf_prefix}${name}_mount" use_nominal_extrinsics="true" use_mesh="${use_camera_mesh}" name="${name}">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </xacro:sensor_d435>

    </xacro:macro>
</robot>
